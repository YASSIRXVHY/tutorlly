{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "nextjs"
    },
    "vite-standalone": {
      "root": "vite-standalone",
      "framework": "vite"
    }
  },
  "rewrites": [
    {
      "source": "/vite/(.*)",
      "destination": {
        "service": "vite-standalone"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "app"
      }
    }
  ]
}
